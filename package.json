{
  "author": "Daniel Bucci <dlbucci@superftc.com>",
  "description": "JS13K 2025",
  "dependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/pg": "^8.15.5",
    "okay-site-login": "^0.0.14",
    "pg": "^8.16.3",
    "rokay": "^0.0.38",
    "rollup": "^4.50.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "license": "ISC",
  "main": "_dist/server/kiki.js",
  "name": "kiki",
  "rokay": {
    "port": 4141,
    "theme": "#000",
    "title": "Kiki",
    "version": 5
  },
  "scripts": {
    "build": "rokay build",
    "start": "rokay server:run",
    "watch": "rokay watch",
    "zip": "npm run zip:html && npm run zip:rollup && npm run zip:zip && npm run zip:size",
    "zip:html": "curl localhost:4141 -H 'Accept: text/html' > static/index.html",
    "zip:rollup": "rollup --input static/kiki.js --file static/kiki.min.js --format cjs --plugin terser",
    "zip:size": "ls -al static/build.zip | awk '{print $5}'",
    "zip:zip": "cd static && rm -f build.zip && zip build.zip art/*.png art/icons/16.png index.html kiki.min.js manifest.json"
  },
  "type": "module",
  "version": "1.0.0"
}
