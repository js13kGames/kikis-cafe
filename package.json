{
  "author": "Daniel Bucci <dlbucci@superftc.com>",
  "description": "JS13K 2025",
  "dependencies": {
    "@types/pg": "^8.15.5",
    "okay-site-login": "^0.0.14",
    "pg": "^8.16.3",
    "rokay": "^0.0.38",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "license": "ISC",
  "main": "_dist/server/kiki.js",
  "name": "kiki",
  "rokay": {
    "port": 4141,
    "theme": "#000",
    "title": "Kiki",
    "version": 5
  },
  "scripts": {
    "build": "rokay build",
    "start": "rokay server:run",
    "watch": "rokay watch",
    "package": "npm run package:html && npm run package:zip && npm run package:size",
    "package:html": "curl localhost:4141 -H 'Accept: text/html' > static/index.html",
    "package:size": "ls -al static/build.zip | awk '{print $5}'",
    "package:zip": "cd static && zip build.zip art/**/*.png index.html kiki.js manifest.json"
  },
  "type": "module",
  "version": "1.0.0"
}
